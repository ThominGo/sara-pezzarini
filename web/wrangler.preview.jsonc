{
  // Version « aperçu » pour l'onglet Presentation du Studio (rendu à la demande, brouillons)
  // Le build Astro génère dist/server/wrangler.json à partir de ce fichier.
  "name": "sara-pezzarini-preview",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": { "directory": "./dist", "binding": "ASSETS" }
}
