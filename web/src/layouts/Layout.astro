---
import '../styles/global.css';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { PREVIEW } from '../utils/preview';
interface Props { title: string; description?: string }
const { title, description = "Sara Pezzarini, ergothérapeute en libéral autour de Mézy-sur-Seine (Yvelines, Val-d'Oise, Eure)." } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');
      // Mise à l'échelle de la maquette 1512 px à la largeur de la fenêtre
      (function () {
        var html = document.documentElement;
        function fit() {
          var z = html.clientWidth / 1512;
          html.style.setProperty('--zoom', String(z));
        }
        fit();
        addEventListener('resize', fit);
      })();
    </script>
    <link rel="preload" href="/fonts/Lexend-Variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/BricolageGrotesque-Variable.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <div id="page"><slot /></div>
    <VisualEditing enabled={PREVIEW} />
    <script>import '../scripts/interactions.ts';</script>
  </body>
</html>
