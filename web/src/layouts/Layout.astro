---
import '../styles/global.css';
import '../styles/mobile.css';
import '../styles/dark.css';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { PREVIEW } from '../utils/preview';
import { ClientRouter } from 'astro:transitions';
import { site as cfg } from '../utils/site';
import A11yPanel from '../components/A11yPanel.astro';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = "Sara Pezzarini, ergothérapeute en libéral autour de Mézy-sur-Seine (Yvelines, Val-d'Oise, Eure).", noindex = false } = Astro.props;
// Tant que le site n'a pas son vrai domaine (PUBLIC_SITE_URL), il n'est pas indexé : textes provisoires
const LIVE = !!import.meta.env.PUBLIC_SITE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const token = cfg.settings.analyticsToken;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Le site n'a qu'un thème clair : on empêche le navigateur de l'assombrir lui-même (icônes et illustrations disparaissaient) -->
    <meta name="color-scheme" content="only light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || !LIVE) && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Sara Pezzarini, ergothérapeute" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Statistiques de visite sans cookie (Cloudflare Web Analytics), si un jeton est renseigné dans le Studio -->
    {token && !PREVIEW && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token })}></script>}
    <script is:inline>
      // Réglages du panneau Accessibilité (posés avant l'affichage, et remis après chaque changement de page)
      window.__a11y = function () {
        var p = {}; try { p = JSON.parse(localStorage.getItem('a11y') || '{}'); } catch (e) {}
        var h = document.documentElement;
        ['dark', 'spacing', 'font', 'dys', 'contrast', 'calm', 'links'].forEach(function (k) { h.classList.toggle('a11y-' + k, !!p[k]); });
        h.dataset.a11ySize = String(p.size || 0);
        return p;
      };
      window.__a11y();
      window.__calm = function () { return matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('a11y-calm'); };
      if (!window.__calm()) document.documentElement.classList.add('anim');
      // Mise à l'échelle de la maquette (1512 px ou 390 px) à la largeur de la fenêtre
      (function () {
        var html = document.documentElement;
        function fit() {
          // maquette desktop 1512 px, maquette mobile 390 px (sous 768 px)
          var z = html.clientWidth / (html.clientWidth < 768 ? 390 : 1512);
          html.style.setProperty('--zoom', String(z));
        }
        fit();
        addEventListener('resize', fit);
        // Changement de page sans rechargement : Astro remplace les attributs de <html>, on remet l'échelle et les classes.
        // .vt : arrivée par une transition, le dégradé du hero arrive déjà en couleur.
        document.addEventListener('astro:after-swap', function () {
          fit();
          window.__a11y();
          if (!window.__calm()) html.classList.add('anim');
          html.classList.add('vt');
        });
      })();
    </script>
    <!-- Changement de page sans rechargement, avec la transition (fiable sur tous les navigateurs).
         Pas dans l'aperçu Sanity, pour ne pas gêner l'édition visuelle. -->
    {!PREVIEW && <ClientRouter fallback="none" />}
    <link rel="preload" href="/fonts/Lexend-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BricolageGrotesque-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#page" class="skip-link">Aller au contenu</a>
    <main id="page" tabindex="-1"><slot /></main>
    {!PREVIEW && <A11yPanel />}
    <VisualEditing enabled={PREVIEW} />
    <script>import '../scripts/interactions.ts';</script>
  </body>
</html>
