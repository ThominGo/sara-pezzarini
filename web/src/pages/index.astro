---
import { loadContent } from '../utils/content';
await loadContent();
import Layout from '../layouts/Layout.astro';
import Page from '../figma/accueil';
import { getProjectCards } from '../utils/projectCards';

const cards = await getProjectCards();
---
<Layout title="Sara Pezzarini, ergothérapeute en libéral dans les Yvelines" description="Ergothérapeute en libéral autour de Mézy-sur-Seine : accompagnement des adultes et adolescents (TSA, handicap psychique) et des organisations, en Yvelines, Val-d’Oise et Eure."><Page cards={cards} /></Layout>
