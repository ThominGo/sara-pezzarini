---
import Layout from '../../layouts/Layout.astro';
import Page, { defaultCards } from '../../figma/projets';
import { getProjects, urlFor } from '../../utils/sanity';

const projects = (await getProjects()) ?? [];
// Styles des vignettes repris de la maquette, dans l'ordre
const cards = projects.length
  ? projects.map((p, i) => ({
      ...defaultCards[i % defaultCards.length],
      title: p.title,
      href: `/projets/${p.slug}`,
      image: p.cover ? urlFor(p.cover).width(1200).auto('format').url() : undefined,
    }))
  : defaultCards;
---
<Layout title="Projets · Sara Pezzarini"><Page cards={cards} /></Layout>
